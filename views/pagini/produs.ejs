<!DOCTYPE html>
<html  lang="ro">
    <head>
        <meta name="description" content="PostLib - Pagina dedicata magazinului virtual pentru cumpararea de continut digital">
        <meta name="keywords" content="<%- locals.prod.title %>, <%- locals.prod.username %>, <%- locals.prod.tags %>, <%- locals.prod.cont_type %>">
        
        <title>PostLib - <%- locals.prod.title %></title>
        <%- include("../fragmente/head") %>     
        <link href="/resurse/css/produs.css" type="text/css" rel="stylesheet" />
    </head>

        <%- include("../fragmente/header") %>
    <main>
        <section>
            <h2>Pagină produs</h2>
                <article id="art-produs">
                    <h3><span class="nume"><%- locals.prod.title %></span></h3>
                    <p>Tip continut digital: <span class="cont_type"><%- locals.prod.cont_type %> </span></p>
                    <p>Pret: <span class="pret"><%- locals.prod.price %> EUR</span></p>
                    <p>Descriere: <span class="descriere"><%- locals.prod.description %> </span></p>
                    <p>Postat de: <span class="username"><%- locals.prod.username %> </span></p>
                    <p>Etichete: <span class="tags"><%- locals.prod.tags %> </span></p>
                    <p>Dimensiune Fisier: <span class="file-size"><%- locals.prod.file_size %> MB</span></p>
                    <p>Categorie: <span class="categorie"><%- locals.prod.cont_categ %> </span></p>
                    <% if(locals.prod.available) { %>
                        <p>Disponibil: <span class="available">Da</span></p>
                    <% } else { %>
                        <p>Disponibil: <span class="available">Nu</span></p>
                    <% } %>
                    <p>Data postare: 
                        <span class="upload-date">
                            <time datetime="<%- new Date(locals.prod.upload_date).toISOString().split('T')[0] %>"></time>
                        </span>
                    </p>
                    <p>Licenta: <span class="license"><%- locals.prod.lic_type %> </span></p>
                    <figure class="imag-produs">
                        <img  src="/resurse/imagini/produse/thumbnails/<%- locals.prod.thumbnail %>" alt="[imagine <%- locals.prod.title %>]" />
                    </figure>
                    <% if(locals.prod.audio_file) { %>
                        <audio controls>
                            <source src="/resurse/audio/ringtones/<%- locals.prod.audio_file %>" type="audio/mpeg"> Browserul tău nu suportă elementul audio.
                        </audio>
                    <% } %>   
                </article>
            
        </section>
    </main>

    <%- include("../fragmente/footer") %>
    <script src="/resurse/js/date_conversion.js"></script>
    </body>
</html>