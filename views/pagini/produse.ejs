<!DOCTYPE html>
<html  lang="ro">
    <head>
        <meta name="description" content="PostLib - Pagina dedicata magazinului virtual pentru cumpararea de continut digital">
        <meta name="keywords" content="fundaluri, tonuri de apel, wallpapers, ringtones, aviatie, arhitectura, dark, trap beat, phonk">
        <link rel="stylesheet" href="/resurse/css/produse.css" type="text/css" />
        <title>PostLib - Marketplace</title>
        <%- include("../fragmente/head") %>     
        <script type="text/javascript" src=/resurse/js/produse.js></script>
        <script type="text/javascript" src=/resurse/js/produse-cos.js></script>

    </head>
    <body>


    <%- include("../fragmente/header") %>

    <main>
        <label> Nume: <input type="text" id="inp-nume"></label>
        <!--<label> Maxim calorii: <input type="number" id="inp-calorii" value="10000"></label>-->
        <div> Calorii:<!-- trebuie sa aiba acelasi name ca sa formeze un grup -->
            <p><label>Dietetic (calorii &lt; 350)
                <input id="i_rad1"  name="gr_rad" value="0:350" type="radio"/>
            </label></p>
            <p><label>Mediu (350 &le; calorii &lt; 700)
                <input id="i_rad2"  name="gr_rad" value="350:700" type="radio"/>
            </label>
            <p><label>Ridicat caloric (700 &le; calorii)
                <input id="i_rad3" name="gr_rad" value="700:1000000000" type="radio"/>
            </label>
            <p><label>Toate
                <input id="i_rad4" checked name="gr_rad" value="toate" type="radio"/>
            </label>
        </div>


        <label> Pret minim: <input type="range" id="inp-pret" value="0" min="0"  max="70"> <span id="infoRange">(0)</span></label>
        <label>Select simplu:
            <select id="inp-categorie">
                <option id="sel-toate" selected value="toate">toate</option>
                <% for (let opt of locals.optiuni) { %>
                    <option value="<%- opt.unnest %>"><%- opt.unnest %> </option>
                <% } %>
            </select>
        </label>

        <p>
        <button class="c1 c2 c3" id="filtrare">Filtreaza</button> 

        <button id="resetare">Reseteaza</button><br/>
        <button id="sortCrescNume">Sorteaza crescator dupa pret si nume</button>
        <button id="sortDescrescNume">Sorteaza descrescator dupa pret si nume</button>
        
        </p>
      
        <p id="p-suma">Apăsați Alt+"c" pentru suma preturilor produselor afișate. </p>
  
        <section id="produse">

            <h2>Produse</h2>
            <div class="grid-produse">
                <% for( let prod of locals.produse) { %>
                    <article class="produs" >
                        <h3 class="nume">Titlu: <a href="/produs/<%-prod.id_asset %>" ><span class="val-nume"><%- prod.title%></span></a></h3>
                        <div class="info-prod">
                            <p class="username">Postat de: <span class="val-username"><%- prod.username%></span></p>
                            <p class="pret">Pret: <span class="val-pret"><%- prod.price%> EUR</span></p>
                            <p class="file-size">Dimensiune Fisier: <span class="val-file-size"><%- prod.file_size%> MB</span></p>
                            <p class="license">Licenta: <span class="val-license"><%- prod.lic_type%></span></p>
                            <% if(prod.available) { %>
                                <p>Disponibil: <span class="available">Da</span></p>
                            <% } else { %>
                                <p>Disponibil: <span class="available">Nu</span></p>
                            <% } %>
                        </div>
                        <p class="categorie">Pentru:<span class="val-categorie"><%- prod.cont_categ%></span></p>
                        <figure>
                            <a href="/produs/<%-prod.id_asset %>" ><img src="/resurse/imagini/produse/thumbnails/<%- prod.thumbnail %>" style="width:50%;height:auto;" alt="[imagine <%- prod.title %>]" /></a>
                        </figure>
                        <% if(prod.audio_file) { %>
                            <audio controls>
                                <source src="/resurse/audio/ringtones/<%- prod.audio_file %>" type="audio/mpeg"> Browserul tău nu suportă elementul audio.
                            </audio>
                        <% } %>
                        <label class="selecteaza-cos">
                            Selectează:<br/>
                            <input type="checkbox" class="select-cos" value="<%-prod.id_asset %>" autocomplete="off">
                        </label>
                    </article>
                <% }%>
            </div>
        </section>
    </main>

    <%- include("../fragmente/footer") %>
    </body>
</html>